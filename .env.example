# Copy to .env.local and fill in. Placeholders only — never commit real values.

# Base44 app connection (used only by the full app, not by demo/)
VITE_BASE44_APP_ID=your_base44_app_id
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app

# School branding and sign-in restriction
VITE_SCHOOL_NAME=Example Junior High
VITE_PROGRAM_NAME=EAST Classroom
VITE_DISTRICT_SHORT_NAME=district
VITE_SCHOOL_EMAIL_DOMAIN=example.org
VITE_SCHOOL_LOGO_URL=
VITE_SCHOOL_CALENDAR_PAGE_URL=
VITE_SCHOOL_CALENDAR_IMAGE_URL=

# Base44 backend function secret (set in the Base44 dashboard, not in this file)
# CLASSROOM_PHOTO_FOLDER_URL=https://drive.google.com/drive/folders/your_public_folder_id
