{
  "name": "PitchLifecycle",
  "type": "object",
  "properties": {
    "pitch_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "archived",
        "deleted"
      ]
    }
  },
  "required": [
    "pitch_id",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}