{
  "name": "DoNowResponse",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "school_date": {
      "type": "string",
      "format": "date"
    },
    "answer": {
      "type": "string"
    }
  },
  "required": [
    "question_id",
    "student_id",
    "school_date",
    "answer"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}