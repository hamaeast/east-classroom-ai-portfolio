{
  "name": "AssignmentGrade",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "points": {
      "type": "number",
      "minimum": 0
    },
    "auto_points": {
      "type": "number",
      "minimum": 0
    },
    "is_late": {
      "type": "boolean",
      "default": false
    },
    "excused": {
      "type": "boolean",
      "default": false,
      "description": "Excused grades display and export as blank and do not count toward totals"
    },
    "status": {
      "type": "string",
      "enum": [
        "graded",
        "pending_review"
      ],
      "default": "graded"
    },
    "teacher_note": {
      "type": "string"
    }
  },
  "required": [
    "assignment_id",
    "student_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}