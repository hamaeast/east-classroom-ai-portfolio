{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "student_names": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "community_need": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "blocked",
        "complete",
        "inactive"
      ],
      "default": "planning"
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "technology_tools": {
      "type": "string"
    },
    "next_milestone": {
      "type": "string"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "project_pitch_id": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "school_year": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "student_names"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}