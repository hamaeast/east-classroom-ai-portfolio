{
  "name": "GoalCoachingProfile",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "needs_coaching": {
      "type": "boolean"
    },
    "vague_goal_count": {
      "type": "number"
    },
    "unmet_goal_count": {
      "type": "number"
    },
    "recent_examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "student_id",
    "needs_coaching",
    "vague_goal_count",
    "unmet_goal_count",
    "recent_examples",
    "assessed_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}