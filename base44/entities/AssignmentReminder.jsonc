{
  "name": "AssignmentReminder",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "assignment_title": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "due_time": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "missing",
        "late_deduction"
      ],
      "default": "missing"
    },
    "points_deducted": {
      "type": "number",
      "minimum": 0
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "zero_recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "assignment_id",
    "student_id",
    "assignment_title",
    "due_date",
    "message",
    "zero_recorded_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}