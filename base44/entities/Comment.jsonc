{
  "name": "Comment",
  "type": "object",
  "properties": {
    "parent_type": {
      "type": "string",
      "enum": [
        "check_in",
        "pitch"
      ],
      "description": "What this comment belongs to"
    },
    "parent_id": {
      "type": "string",
      "description": "ID of the parent record"
    },
    "message": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "admin",
        "student"
      ]
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs allowed to read this conversation"
    }
  },
  "required": [
    "parent_type",
    "parent_id",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}