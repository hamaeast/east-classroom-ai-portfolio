{
  "name": "HelpRequest",
  "type": "object",
  "properties": {
    "student_name": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "The student's urgent help question"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "answered",
        "dismissed"
      ],
      "default": "open"
    },
    "admin_response": {
      "type": "string"
    }
  },
  "required": [
    "student_name",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}