{
  "name": "PitchNotification",
  "type": "object",
  "properties": {
    "pitch_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "communication",
        "approved"
      ]
    },
    "message": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "pitch_id",
    "recipient_id",
    "type",
    "message",
    "read"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}