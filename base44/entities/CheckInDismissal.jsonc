{
  "name": "CheckInDismissal",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "User id of the student"
    },
    "student_name": {
      "type": "string"
    },
    "week_ending": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "week_ending",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}