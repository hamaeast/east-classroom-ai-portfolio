{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 * * 1",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Adds each student's five-point live Project Work grade every instructional Monday.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monday_project_work_grades",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "initialize_scores": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ensureProjectWorkGrades",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Start weekly Project Work grades",
            "description": "Five points per student, adjusted for off-task marks"
          }
        }
      }
    ]
  },
  "name": "Monday Project Work Grades"
}