{
  "name": "Weekly Check-in Help Summary",
  "description": "Every Saturday at 1am, emails admins a summary of students who requested help in their weekly check-in. Skips weeks that were exempted from check-ins.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_checkin_help_summary",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendHelpNeededSummary",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send help summary email",
            "description": "To admins"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 1 * * 6",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}